foreach(required LTFA_CLI LTFA_RING_ROOT LTFA_SCRATCH)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "missing ${required}")
    endif()
endforeach()
file(READ "${LTFA_RING_ROOT}/main.ltfa" model)
file(MAKE_DIRECTORY "${LTFA_SCRATCH}")
function(run_case name expected)
    execute_process(COMMAND "${LTFA_CLI}" forwarding --model-root "${LTFA_RING_ROOT}"
        --input main.ltfa --domain ring:main --source switch:1 ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "${name}: status=${result} expected=${expected} stdout=${output} stderr=${error}")
    endif()
    set("${name}" "${output}" PARENT_SCOPE)
endfunction()
function(assert_equal json expected)
    string(JSON actual GET "${json}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${actual}: ${json}")
    endif()
endfunction()
run_case(normal 0 --format json)
assert_equal("${normal}" ltfa.forwarding/v1 schema)
assert_equal("${normal}" complete result)
assert_equal("${normal}" turbo-ring normal protocol)
assert_equal("${normal}" available normal links 3 intrinsic_physical)
assert_equal("${normal}" available normal links 3 effective_physical)
assert_equal("${normal}" blocking normal links 3 logical)
assert_equal("${normal}" OFF normal backup_activated)
assert_equal("${normal}" "" normal recovery_time_ms)
assert_equal("${normal}" "" post_failure)
foreach(i RANGE 0 3)
    assert_equal("${normal}" reachable normal devices ${i} reachability)
endforeach()
run_case(single 0 --failure failure:link-1 --format json)
assert_equal("${single}" ON post_failure backup_activated)
assert_equal("${single}" unavailable post_failure links 0 intrinsic_physical)
assert_equal("${single}" forwarding post_failure links 3 logical)
foreach(i RANGE 0 3)
    assert_equal("${single}" reachable post_failure devices ${i} reachability)
endforeach()
run_case(two 0 --failure failure:link-1 --failure failure:link-3 --format json)
assert_equal("${two}" unreachable post_failure devices 1 reachability)
assert_equal("${two}" unreachable post_failure devices 2 reachability)
assert_equal("${two}" reachable post_failure devices 3 reachability)
run_case(reverse 0 --failure failure:link-3 --failure failure:link-1 --format json)
if(NOT "${two}" STREQUAL "${reverse}")
    message(FATAL_ERROR "fault input ordering changed deterministic output")
endif()
run_case(device 0 --failure failure:switch-2 --format json)
assert_equal("${device}" available post_failure links 0 intrinsic_physical)
assert_equal("${device}" unavailable post_failure links 0 effective_physical)
assert_equal("${device}" unreachable post_failure devices 1 reachability)
run_case(human 0 --failure failure:link-1)
if(NOT human MATCHES "Post-failure:" OR NOT human MATCHES "recovery-time: unknown" OR human MATCHES "SPOF")
    message(FATAL_ERROR "invalid human forwarding contract: ${human}")
endif()
run_case(budget 0 --max-visited-objects 1 --format json)
assert_equal("${budget}" incomplete result)
run_case(post_budget 0 --max-visited-objects 16 --failure failure:link-1 --format json)
assert_equal("${post_budget}" incomplete post_failure result)
run_case(propagation_budget 0 --max-events 1 --failure failure:link-1 --failure failure:link-3 --format json)
assert_equal("${propagation_budget}" incomplete post_failure result)
foreach(i RANGE 0 3)
    assert_equal("${propagation_budget}" unknown post_failure devices ${i} reachability)
endforeach()
run_case(invalid_budget 2 --max-events 0 --format json)
assert_equal("${invalid_budget}" ltfa.cli-error/v1 schema)
run_case(invalid_failure 4 --failure no:such --format json)
assert_equal("${invalid_failure}" ltfa.cli-error/v1 schema)
function(run_variant name text expected)
    file(WRITE "${LTFA_SCRATCH}/main.ltfa" "${text}")
    execute_process(COMMAND "${LTFA_CLI}" forwarding --model-root "${LTFA_SCRATCH}"
        --input main.ltfa --domain ring:main --source switch:1 --format json ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "${name}: expected=${expected} got=${result}: ${output} ${error}")
    endif()
    set("${name}" "${output}" PARENT_SCOPE)
endfunction()
string(REPLACE "protocol=turbo-ring" "protocol=rstp" unsupported_model "${model}")
run_variant(unsupported "${unsupported_model}" 0)
assert_equal("${unsupported}" incomplete result)
assert_equal("${unsupported}" rstp normal protocol)
string(REPLACE " normal-state=blocking" "" missing_model "${model}")
run_variant(missing_policy "${missing_model}" 0)
assert_equal("${missing_policy}" incomplete result)
string(REPLACE "link:1 -> ring:main kind=member_of normal-state=forwarding"
    "link:1 -> ring:main kind=member_of normal-state=blocking" ambiguous_model "${model}")
run_variant(ambiguous_policy "${ambiguous_model}" 0)
assert_equal("${ambiguous_policy}" incomplete result)
string(REPLACE "entity switch:2 kind=device" "entity switch:2 sensitivity=restricted kind=device" restricted_model "${model}")
run_variant(restricted "${restricted_model}" 4)
assert_equal("${restricted}" ltfa.cli-error/v1 schema)
run_variant(restricted_explicit "${restricted_model}" 0 --include-restricted)
assert_equal("${restricted_explicit}" complete result)
set(overlap_model "${model}failure failure:weak target=link:1 mode=noise\n")
run_variant(overlap "${overlap_model}" 0 --failure failure:link-1 --failure failure:weak)
assert_equal("${overlap}" unavailable post_failure links 0 intrinsic_physical)
execute_process(COMMAND "${LTFA_CLI}" help forwarding --format json
    RESULT_VARIABLE result OUTPUT_VARIABLE help)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "help forwarding failed")
endif()
assert_equal("${help}" forwarding commands 0 operation)
execute_process(COMMAND "${LTFA_CLI}" guide workflows forwarding --format json
    RESULT_VARIABLE result OUTPUT_VARIABLE guide)
if(NOT result EQUAL 0 OR NOT guide MATCHES "post-convergence")
    message(FATAL_ERROR "forwarding guide failed: ${guide}")
endif()
run_case(relation_budget 0 --max-examined-relations 1 --format json)
assert_equal("${relation_budget}" incomplete result)
execute_process(COMMAND "${LTFA_CLI}" forwarding --model-root "${LTFA_RING_ROOT}" --input main.ltfa
    --domain ring:main --source switch:1:a --failure failure:link-1 --format json
    RESULT_VARIABLE result OUTPUT_VARIABLE endpoint)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "source endpoint mapping failed: ${endpoint}")
endif()
assert_equal("${endpoint}" reachable post_failure devices 0 reachability)
execute_process(COMMAND "${LTFA_CLI}" forwarding --model-root "${LTFA_RING_ROOT}" --input main.ltfa
    --domain ring:main --source switch:2 --failure failure:switch-2 --format json
    RESULT_VARIABLE result OUTPUT_VARIABLE failed_source)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "source failure snapshot rejected: ${failed_source}")
endif()
foreach(i RANGE 0 3)
    assert_equal("${failed_source}" unreachable post_failure devices ${i} reachability)
endforeach()
string(REPLACE "connect link:3 -- switch:4:a kind=network\n" "" malformed_model "${model}")
run_variant(malformed_cycle "${malformed_model}" 4)
assert_equal("${malformed_cycle}" ltfa.cli-error/v1 schema)
run_variant(parse_error "ltfa 1\ninvalid-statement\n" 3)
assert_equal("${parse_error}" ltfa.cli-error/v1 schema)
execute_process(COMMAND "${LTFA_CLI}" forwarding --format json
    RESULT_VARIABLE missing_result OUTPUT_VARIABLE missing_output)
if(NOT missing_result EQUAL 2)
    message(FATAL_ERROR "missing options should fail usage: ${missing_output}")
endif()
assert_equal("${missing_output}" ltfa.cli-error/v1 schema)
execute_process(COMMAND "${LTFA_CLI}" forwarding --model-root "${LTFA_RING_ROOT}" --input main.ltfa
    --domain ring:main --source switch:1 --format dot
    RESULT_VARIABLE format_result ERROR_VARIABLE format_error)
if(NOT format_result EQUAL 2)
    message(FATAL_ERROR "unsupported forwarding output format must fail")
endif()
