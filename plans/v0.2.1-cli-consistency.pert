# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project LTFA_CLI_REPAIR:
  version 4
  title "LTFA assurance CLI consistency repair"
  description "Independent repair plan for GitHub Issue #1 after the v0.2.0 CLI consistency, symmetry, and completeness review. It covers cumulative work-budget enforcement, assurance output parity, exact help grammar, acceptance coverage, and repair acceptance. It excludes observation features, network or execution effects, schema-version changes without a separate compatibility decision, tag creation, and release publication."
  as_of 2026-07-29
  duration_unit day
  finish CLI_REPAIR_ACCEPTED
  goal_owner user
  dag_owner user
  dag_delegates [codex]

milestone V020_REVIEWED:
  title "v0.2.0 review findings accepted"
  state reached

resource CODEX:
  title "LTFA implementation capacity"
  description "Serialize implementation and test changes in this checkout"
  capacity 1

resource REVIEW:
  title "Contract and acceptance review capacity"
  description "Serialize public-contract and final acceptance review"
  capacity 1

milestone BUDGET_REPAIR_READY:
  title "Shared cumulative budgets repaired"

milestone OUTPUT_CONTRACT_READY:
  title "Assurance public field inventory accepted"

milestone OUTPUT_PARITY_READY:
  title "Human and JSON assurance output aligned"

milestone HELP_COVERAGE_READY:
  title "Exact help and CLI acceptance coverage ready"

milestone CLI_REPAIR_INTEGRATED:
  title "CLI repair workstreams integrated"

milestone CLI_REPAIR_ACCEPTED:
  title "Assurance CLI consistency repair accepted"

task CLI_SHARED_BUDGET_REPAIR V020_REVIEWED -> BUDGET_REPAIR_READY:
  title "Enforce shared path and SPOF work budgets"
  description "Reproduce the v0.2.0 overrun, carry remaining object and relation work into SPOF analysis, preserve deterministic incomplete results, and add boundary and exhaustion regressions proving combined path and SPOF usage never exceeds either configured cumulative limit."
  estimate:
    optimistic 1d
    most_likely 2d
    pessimistic 3d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [cli, budget, regression, patch]
  source "GitHub Issue #1; ADR 0003 cumulative-work contract; post-v0.2.0 CLI review"

task CLI_ASSURANCE_FIELD_INVENTORY V020_REVIEWED -> OUTPUT_CONTRACT_READY:
  title "Define the assurance public field inventory"
  description "Enumerate every public ltfa.assurance/v1 fact, map it to deterministic human and JSON representations, and explicitly classify core-only propagation fields so omissions are intentional. Retain schema v1 unless a separate compatibility decision approves a version change."
  estimate:
    optimistic 0.5d
    most_likely 1d
    pessimistic 1.5d
  priority 95
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [cli, contract, output]
  source "GitHub Issue #1; ADR 0003 result contract; post-v0.2.0 CLI review"

task CLI_OUTPUT_PARITY OUTPUT_CONTRACT_READY -> OUTPUT_PARITY_READY:
  title "Restore human and JSON output parity"
  description "Render the accepted public field inventory in both formats with stable ordering, including SPOF path details and qualifications plus propagation previous state, event qualification, and unaffected objects. Add field-presence parity and deterministic-output tests without weakening restricted-ID handling."
  estimate:
    optimistic 0.5d
    most_likely 1d
    pessimistic 1.5d
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [cli, human, json, regression]
  source "GitHub Issue #1; accepted assurance public field inventory"

task CLI_HELP_AND_ACCEPTANCE_COVERAGE V020_REVIEWED -> HELP_COVERAGE_READY:
  title "Complete analyze help and CLI acceptance coverage"
  description "Expand the descriptor-backed analyze usage to list every budget option, validate structured detailed analyze help, cover every budget option and invalid value, exercise all source, target, scope, endpoint, and declared-failure rejection branches, and rename or split the CTest acceptance target to match its scope."
  estimate:
    optimistic 1d
    most_likely 2d
    pessimistic 3d
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [cli, help, acceptance, coverage]
  source "GitHub Issue #1; ADR 0003 CLI conventions; post-v0.2.0 CLI review"

gate CLI_BUDGET_REPAIR_GATE BUDGET_REPAIR_READY -> CLI_REPAIR_INTEGRATED:
  reason "Integration requires the cumulative-budget contract repair"

gate CLI_OUTPUT_PARITY_GATE OUTPUT_PARITY_READY -> CLI_REPAIR_INTEGRATED:
  reason "Integration requires accepted human and JSON public-fact parity"

gate CLI_HELP_COVERAGE_GATE HELP_COVERAGE_READY -> CLI_REPAIR_INTEGRATED:
  reason "Integration requires exact help and complete CLI acceptance coverage"

task CLI_REPAIR_ACCEPTANCE CLI_REPAIR_INTEGRATED -> CLI_REPAIR_ACCEPTED:
  title "Accept the assurance CLI consistency repair"
  description "Record Issue-linked acceptance evidence, run the Release build and complete CTest suite with warnings as errors, rerun sanitizer, installed-tree, and offline-boundary gates, verify deterministic complete and incomplete output, and confirm that tag creation and release publication remain outside this repair plan."
  estimate:
    optimistic 1d
    most_likely 1d
    pessimistic 2d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [cli, acceptance, offline, patch]
  source "GitHub Issue #1 acceptance criteria; AGENTS.md build and offline boundaries"
