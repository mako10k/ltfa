# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project LTFA_CLI_REPAIR:
  version 5
  title "LTFA assurance CLI consistency repair"
  description "Independent repair plan for GitHub Issue #1 after the v0.2.0 CLI consistency, symmetry, and completeness review. It covers cumulative work-budget enforcement, assurance output parity, exact help grammar, acceptance coverage, and repair acceptance. It excludes observation features, network or execution effects, schema-version changes without a separate compatibility decision, tag creation, and release publication."
  as_of 2026-07-29
  duration_unit day
  finish CLI_REPAIR_ACCEPTED
  goal_owner user
  dag_owner user
  dag_delegates [codex]


resource CODEX:
  title "LTFA implementation capacity"
  description "Serialize implementation and test changes in this checkout"
  capacity 2

resource REVIEW:
  title "Contract and acceptance review capacity"
  description "Serialize public-contract and final acceptance review"
  capacity 1





milestone CLI_REPAIR_INTEGRATED:
  title "CLI repair workstreams integrated"
  state reached

milestone CLI_REPAIR_ACCEPTED:
  title "Assurance CLI consistency repair accepted"








task CLI_REPAIR_ACCEPTANCE CLI_REPAIR_INTEGRATED -> CLI_REPAIR_ACCEPTED:
  title "Accept the assurance CLI consistency repair"
  description "Record Issue-linked acceptance evidence, run the Release build and complete CTest suite with warnings as errors, rerun sanitizer, installed-tree, and offline-boundary gates, verify deterministic complete and incomplete output, and confirm that tag creation and release publication remain outside this repair plan."
