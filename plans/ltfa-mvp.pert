# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project LTFA_MVP:
  version 5
  title "LTFA offline MVP prototype"
  description "Residual implementation plan derived from the reviewed LTFA requirements, basic design delivery slices, and design-review approval conditions. The existing C++17 bootstrap scaffold is the reached frontier. This plan covers the offline model compiler, assurance analyses, observation diagnosis, bounded advanced analysis, and prototype measurement; it excludes live probes, CMDB mutation, adapters, release publication, and performance claims without evidence."
  as_of 2026-07-28
  duration_unit day
  finish MVP_ACCEPTED
  goal_owner user
  dag_owner user


resource CODEX:
  title "LTFA implementation capacity"
  description "Serialize implementation work in this checkout"
  capacity 1

resource REVIEW:
  title "Design and acceptance review capacity"
  description "Serialize cross-cutting contract and acceptance review"
  capacity 1
















milestone OBS_DECODER_READY:
  title "Observation decoder ready"
  state reached

milestone EVIDENCE_READY:
  title "Freshness and conflict evidence ready"

milestone DIAGNOSIS_READY:
  title "Deterministic diagnosis ready"

milestone AMI_FIXTURE_READY:
  title "Redacted Ami-A-derived fixture ready"

milestone SLICE3_INTEGRATED:
  title "Observation diagnosis inputs integrated"

milestone SLICE3_ACCEPTED:
  title "Observation diagnosis slice accepted"

milestone CUT_READY:
  title "Bounded cut analysis ready"

milestone NEXT_OBSERVATION_READY:
  title "Next-observation recommendation ready"

milestone SLICE4_INTEGRATED:
  title "Advanced analysis inputs integrated"

milestone SLICE4_ACCEPTED:
  title "Bounded advanced analysis slice accepted"

milestone BENCHMARK_TARGETS_READY:
  title "Prototype benchmark targets pinned"

milestone MVP_ACCEPTED:
  title "Offline MVP prototype accepted"


















task M3_EVIDENCE_INDEX OBS_DECODER_READY -> EVIDENCE_READY:
  title "Implement freshness, vantage, and conflict handling"
  description "Resolve explicit analysis_at, retain history and same-time conflicts, distinguish stale evidence, validate probe contracts, and preserve ICMP timeout as vantage-specific reachability evidence only."
  estimate:
    optimistic 2d
    most_likely 3d
    pessimistic 5d
  status done
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [slice3, evidence]
  source "requirements REQ-OBS-002..008, REQ-OBS-013, AC-005..007; basic design section 10.7"

task M3_DIAGNOSIS EVIDENCE_READY -> DIAGNOSIS_READY:
  title "Implement bounded deterministic diagnosis"
  description "Generate hypotheses only from causal cones, simulate single failures, rank by contradictions and explained evidence without invented probabilities, report ties, unknowns, and budget exhaustion."
  estimate:
    optimistic 3d
    most_likely 5d
    pessimistic 8d
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [slice3, diagnosis]
  source "requirements REQ-ANL-010..015; basic design section 10.7"

task M3_REDACTED_AMI_FIXTURE OBS_DECODER_READY -> AMI_FIXTURE_READY:
  title "Create the redacted Ami-A-derived integration fixture"
  description "Derive only reusable topology and observation structure from approved historical evidence, remove credentials and unrestricted raw detail, and prove the fixture works fully offline."
  estimate:
    optimistic 2d
    most_likely 3d
    pessimistic 5d
  priority 80
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [slice3, fixture, safety]
  source "requirements AC-006, AC-008..009; design review finding REV-009 and prototype condition 2"

gate M3_DIAGNOSIS_GATE DIAGNOSIS_READY -> SLICE3_INTEGRATED:
  reason "Slice 3 acceptance requires deterministic diagnosis"

gate M3_FIXTURE_GATE AMI_FIXTURE_READY -> SLICE3_INTEGRATED:
  reason "Slice 3 acceptance requires the redacted offline fixture"

task M3_ACCEPTANCE SLICE3_INTEGRATED -> SLICE3_ACCEPTED:
  title "Accept the observation diagnosis slice"
  description "Verify strict JSON, explicit reference time, freshness, conflicts, timeout qualification, deterministic ranked findings, byte-stable output, redaction, and zero network or secret dependency."
  estimate:
    optimistic 1d
    most_likely 2d
    pessimistic 3d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [slice3, acceptance]
  source "basic design slice 3; requirements AC-005..009"

task M4_BOUNDED_CUTS SLICE3_ACCEPTED -> CUT_READY:
  title "Implement bounded service cuts and domain scenarios"
  description "Add node splitting and bounded max-flow for node and edge cuts of size one and two, result and work budgets, failure-domain scenario sets, and structured incomplete results."
  estimate:
    optimistic 3d
    most_likely 5d
    pessimistic 8d
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [slice4, analysis]
  source "requirements REQ-ANL-004..006, REQ-PERF-006; basic design section 10.3"

task M4_NEXT_OBSERVATION SLICE3_ACCEPTED -> NEXT_OBSERVATION_READY:
  title "Implement next-useful-observation recommendations"
  description "Compare registered but absent probes for tied hypotheses, select deterministic evidence-gathering suggestions, and state clearly that recommendations never execute a probe."
  estimate:
    optimistic 2d
    most_likely 3d
    pessimistic 5d
  priority 80
  requires:
    CODEX 1
  owner "codex"
  tags [slice4, diagnosis]
  source "requirements MVP-2; basic design section 10.8"

gate M4_CUT_GATE CUT_READY -> SLICE4_INTEGRATED:
  reason "Slice 4 acceptance requires bounded cut analysis"

gate M4_OBSERVATION_GATE NEXT_OBSERVATION_READY -> SLICE4_INTEGRATED:
  reason "Slice 4 acceptance requires non-executing observation recommendations"

task M4_ACCEPTANCE SLICE4_INTEGRATED -> SLICE4_ACCEPTED:
  title "Accept bounded advanced analysis"
  description "Verify cut-size and work bounds, common-domain scenarios, deterministic incomplete results, recommendation-only observation gaps, output stability, and offline safety."
  estimate:
    optimistic 1d
    most_likely 2d
    pessimistic 3d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [slice4, acceptance]
  source "basic design slice 4; requirements REQ-ANL-004..006, REQ-PERF-006"

task MVP_PIN_BENCHMARK_TARGETS SLICE4_ACCEPTED -> BENCHMARK_TARGETS_READY:
  title "Pin prototype benchmark hosts and fixtures"
  description "Select and record reproducible x86_64 and aarch64 hosts, compilers, build profiles, 10k/50k graph fixture, 100k observation fixture, measurement commands, and acceptance caveats."
  estimate:
    optimistic 1d
    most_likely 2d
    pessimistic 3d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [prototype, performance]
  source "requirements REQ-PERF-001..006, AC-010; design review finding REV-012"

task MVP_BENCHMARK_ACCEPTANCE BENCHMARK_TARGETS_READY -> MVP_ACCEPTED:
  title "Measure and accept the offline MVP prototype"
  description "Record binary size, elapsed time, peak RSS, portability, sanitizer and complete acceptance evidence on pinned hosts. Qualify unmet provisional targets instead of claiming success, and retain live probes and release work outside this plan."
  estimate:
    optimistic 3d
    most_likely 5d
    pessimistic 8d
  priority 100
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [prototype, acceptance, performance]
  source "requirements AC-001..010; basic design section 14; design review prototype approval conditions"

