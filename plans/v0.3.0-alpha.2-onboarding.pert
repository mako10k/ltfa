# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project LTFA_V030A2_ONBOARDING:
  version 7
  title "LTFA v0.3.0-alpha.2 onboarding and validation"
  description "Implement GitHub Issue #2 in governed sequence: reconcile accepted-MVP evidence, add reproducible CI, review the observation-guide contract, implement installed diagnosis onboarding, and record candidate evidence. Excludes tags, GitHub Release publication, stable promotion, active probes, SDK installation, and parser streaming."
  as_of 2026-08-25
  duration_unit point
  velocity 1p/1d
  finish V030A2_CANDIDATE_ACCEPTED
  goal_owner user
  dag_owner user
  dag_delegates [codex]



resource CODEX:
  title "LTFA implementation capacity"
  description "Serialize implementation and validation work in this checkout"
  capacity 1

resource REVIEW:
  title "Contract and acceptance review capacity"
  description "Serialize ADR, security, and outcome review"
  capacity 1


milestone CI_BASELINE_READY:
  title "Continuous validation baseline ready"
  description "Pinned least-privilege CI covers supported Release and safety gates without secrets or live endpoints."
  state reached

milestone GUIDE_CONTRACT_REVIEWED:
  title "Observation Guide contract reviewed"
  description "A proposed ADR defines domain separation, public routes, schemas, error navigation, completion, and compatibility."

milestone GUIDE_CONTRACT_ACCEPTED:
  title "Observation Guide contract accepted"
  description "The owner accepts the exact proposed ADR before public Guide implementation begins."

milestone DIAGNOSIS_ONBOARDING_READY:
  title "Installed diagnosis onboarding ready"
  description "Observation guidance, Action Navigation, completion, and the installed synthetic diagnosis example pass focused tests."

milestone CANDIDATE_EVIDENCE_READY:
  title "Candidate evidence ready"
  description "Complete local, CI, install, offline, sanitizer, fuzz, and qualified aarch64 evidence is recorded."

milestone V030A2_CANDIDATE_ACCEPTED:
  title "v0.3.0-alpha.2 candidate accepted"
  description "The owner accepts the bounded candidate evidence; tag and Release publication remain separate."



task DESIGN_OBSERVATION_GUIDE CI_BASELINE_READY -> GUIDE_CONTRACT_REVIEWED:
  title "Design the observation Guide contract"
  description "Create and audit a proposed ADR against ADRs 0007, 0012, and 0015, covering public routes, structured output, error navigation, completion, compatibility, and offline boundaries."
  estimate:
    optimistic 1p
    most_likely 2p
    pessimistic 3p
  status done
  priority 80
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [design, adr, guide]
  source "GitHub Issue #2 https://github.com/mako10k/ltfa/issues/2"

gate OWNER_GUIDE_APPROVAL GUIDE_CONTRACT_REVIEWED -> GUIDE_CONTRACT_ACCEPTED:
  reason "The user must accept the exact observation Guide ADR before implementation; planning approval alone does not accept the public contract."

task IMPLEMENT_DIAGNOSIS_ONBOARDING GUIDE_CONTRACT_ACCEPTED -> DIAGNOSIS_ONBOARDING_READY:
  title "Implement installed diagnosis onboarding"
  description "Implement descriptor-backed observation guidance, help and error navigation, bash completion, a synthetic installed diagnosis example, and focused success and failure tests under the accepted ADR."
  estimate:
    optimistic 3p
    most_likely 5p
    pessimistic 8p
  status planned
  priority 70
  requires:
    CODEX 1
  owner "codex"
  tags [feature, guide, examples, testing]
  source "GitHub Issue #2 https://github.com/mako10k/ltfa/issues/2"

task VERIFY_V030A2_CANDIDATE DIAGNOSIS_ONBOARDING_READY -> CANDIDATE_EVIDENCE_READY:
  title "Verify and record the bounded candidate"
  description "Run complete GCC and Clang Release, sanitizers, fuzz seeds, install readback, offline gates, CI readback, and qualified aarch64 portability; record traceable candidate evidence and residual risks."
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  status planned
  priority 60
  requires:
    CODEX 1
    REVIEW 1
  owner "codex"
  tags [acceptance, portability, release-candidate]
  source "GitHub Issue #2 https://github.com/mako10k/ltfa/issues/2"

gate OWNER_CANDIDATE_APPROVAL CANDIDATE_EVIDENCE_READY -> V030A2_CANDIDATE_ACCEPTED:
  reason "The user must accept the exact candidate evidence; this gate does not authorize a tag, GitHub Release, stable promotion, or publication."

milestone_criterion_set CI_BASELINE_READY_R1:
  milestone CI_BASELINE_READY
  revision R1
  commitment sha256:4e98a1f65c001b0eed6ef5e07529da270d8033342b7e8386ae159a4bd32c2691
  criterion PINNED_LEAST_PRIVILEGE required artifact "Workflow uses a full checkout SHA, contents read, no secrets, no pull_request_target, and non-persisted credentials"
  criterion LOCAL_MATRIX_PASS required test "GCC and Clang Release, ASan UBSan, LSan, and fuzz-seed local suites pass"
  criterion HOSTED_MATRIX_PASS required test "GitHub Actions five-job matrix passes for the exact remote main SHA"
  criterion CI_EVIDENCE_COMMITTED required artifact "Local and hosted CI evidence is committed"

milestone_criterion_set GUIDE_CONTRACT_REVIEWED_R1:
  milestone GUIDE_CONTRACT_REVIEWED
  revision R1
  commitment sha256:62801e4f09ce13992e80c5ee2cd61f18087e3715ddd2f2513342342a03eb751e
  criterion GUIDE_ADR_AUDITED required artifact "Proposed ADR covers domain separation, public routes, schemas, error navigation, completion, compatibility, and offline boundaries"
  criterion GUIDE_TEST_PLAN_REVIEWED required artifact "Focused success, failure, install, and offline tests are specified before implementation"

milestone_criterion_set GUIDE_CONTRACT_ACCEPTED_R1:
  milestone GUIDE_CONTRACT_ACCEPTED
  revision R1
  commitment sha256:d1d19dc5dc9432996d65b7e0a276744a2c9deadc1c5b22f324005b59e6a35b0e
  criterion GUIDE_OWNER_ACCEPTED required owner "Owner accepts the exact proposed ADR before implementation"

milestone_criterion_set DIAGNOSIS_ONBOARDING_READY_R1:
  milestone DIAGNOSIS_ONBOARDING_READY
  revision R1
  commitment sha256:4e7099c341e87890de6f4999e7fe041456f187020bbbe3da95d35093ba84aa6a
  criterion GUIDE_BEHAVIOR_PASS required test "Descriptor-backed observation guidance, help, error navigation, and bash completion focused tests pass"
  criterion INSTALLED_EXAMPLE_PASS required test "Synthetic diagnosis example and Guide routes pass from an installed tree"
  criterion OFFLINE_BOUNDARY_PASS required test "Static and runtime offline boundaries pass without active probes or implicit effects"
  criterion IMPLEMENTATION_EVIDENCE_COMMITTED required artifact "Accepted ADR, implementation tests, and residual risks are committed"

milestone_criterion_set CANDIDATE_EVIDENCE_READY_R1:
  milestone CANDIDATE_EVIDENCE_READY
  revision R1
  commitment sha256:7a4f29750cb30df5f5cd302895134a0bf7da929a4401c5b171edd2e15a0895fe
  criterion REFERENCE_MATRIX_PASS required test "Complete GCC and Clang Release, sanitizer, fuzz, install, and offline gates pass"
  criterion HOSTED_CI_PASS required test "Exact candidate GitHub Actions matrix passes"
  criterion AARCH64_PASS required test "Qualified aarch64 Release semantics, install, and portability gates pass on raspi4"
  criterion CANDIDATE_EVIDENCE_COMMITTED required artifact "Candidate evidence and residual risks are committed"

milestone_criterion_set V030A2_CANDIDATE_ACCEPTED_R1:
  milestone V030A2_CANDIDATE_ACCEPTED
  revision R1
  commitment sha256:17b58f1e3cbcebfcd83e74dba02c8697296436ab7340cd6081951f220a7efcf5
  criterion CANDIDATE_OWNER_ACCEPTED required owner "Owner accepts the exact bounded candidate evidence"


